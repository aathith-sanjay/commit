# --- Local development (docker-compose) ---
DB_URL=jdbc:postgresql://localhost:5434/commit
DB_USERNAME=commit
DB_PASSWORD=commit

# --- JWT ---
# Generate a strong random secret (min 32 chars) — e.g. openssl rand -base64 48
JWT_SECRET=commit-default-dev-secret-key-please-change-in-production-1234567890
JWT_EXPIRATION_DAYS=30

# --- CORS ---
# Set to your frontend origin in production, e.g. https://aathith-sanjay.github.io
CORS_ALLOWED_ORIGINS=*

# --- Render (auto-injected via render.yaml fromDatabase, do not set manually) ---
# DB_HOST=
# DB_PORT=
# DB_NAME=
# DB_USERNAME=
# DB_PASSWORD=
